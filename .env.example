# ─────────────────────────────────────────────────────────────────────────────
# AutoValet – Environment Variables
# Copy this file to .env.local and fill in all values before running locally.
# Add each variable to your Vercel project under Settings > Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Resend (transactional email) ─────────────────────────────────────────────
# Found in: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email settings ───────────────────────────────────────────────────────────
# The "from" address must be from a domain you've verified in Resend
RESEND_FROM_EMAIL=bookings@autovalet.com
# Internal address that receives a copy of every booking
RESEND_ADMIN_EMAIL=admin@autovalet.com

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.autovalet.com
