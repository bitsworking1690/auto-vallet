# ─────────────────────────────────────────────────────────────────────────────
# AutoValet – Environment Variables
# Copy this file to .env.local and fill in all values before running locally.
# Add each variable to your Vercel project under Settings > Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Stripe ────────────────────────────────────────────────────────────────────
# Found in: https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Found in: Stripe Dashboard → Developers → Webhooks (for payment confirmation)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public key – used in the browser (prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend (transactional email) ─────────────────────────────────────────────
# Found in: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email settings ───────────────────────────────────────────────────────────
# The "from" address must be from a domain you've verified in Resend
RESEND_FROM_EMAIL=bookings@autovalet.com
# Internal address that receives a copy of every booking
RESEND_ADMIN_EMAIL=admin@autovalet.com

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.autovalet.com
